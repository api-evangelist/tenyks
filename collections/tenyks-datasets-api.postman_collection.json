            "description": {
              "content": "This endpoint retrieves the information of all your datasets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "workspaces",
                "tenyks",
                "datasets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": " (This can only be one of dashboard,sandbox)",
                  "type": "any",
                  "value": "{{base_url}}",
                  "key": "base_url"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
